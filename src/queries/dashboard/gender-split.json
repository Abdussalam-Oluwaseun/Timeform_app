{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Sales by gender",
  "width": "container",
  "height": "container",
  "mark": { "type": "arc" },
  "encoding": {
    "theta": { "field": "Revenue", "type": "quantitative" },
    "color": {
      "field": "productsgender",
      "type": "nominal",
      "scale": {
        "domain": ["Men", "Women"],
        "range": ["var(--color-brand)", "var(--color-accent)"]
      },
      "legend": { "title": "Gender" }
    }
  }
}
